# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/

# training run outputs (keep results/ which is curated; ignore ad-hoc runs)
results_quickstart/
runs/
tb/
# ... except the dashboard's training runs: keep what a teammate needs to use or continue a run
# (models + summaries), not the bulky live files (telemetry, camera frames, logs, replays)
!results/hoop/runs/
results/hoop/runs/*/*
!results/hoop/runs/*/best_model.zip
!results/hoop/runs/*/latest_model.zip
!results/hoop/runs/*/final_model.zip
!results/hoop/runs/*/meta.json
!results/hoop/runs/*/label.json
!results/hoop/runs/*/live_status.json
!results/hoop/runs/*/evaluations.npz
!results/hoop/runs/*/passes.json
!results/hoop/runs/*/rescore.json
*.log

# ad-hoc stdout/stderr captures from overnight launchers (keep the *.md/*summary.txt reports,
# drop the raw process logs). Same philosophy as the runs/ rule above: summaries, not live files.
results/**/*.out
results/**/*.err
results/**/*.log.err
results/**/*_stdout.txt
results/**/*_stderr.txt
results/**/*.stdout.txt
results/**/*.stderr.txt
results/hoop/gates_rerun.txt
# superseded / buggy runs kept only for local reference: full telemetry, progress, camera
# frames and .tmp files -- exactly the bulky live data the runs/ rule excludes.
results/hoop/runs_archive/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# hardware: flight logs / demos / per-setup calibration are regenerated on each machine
# (`flights/` is deliberately not called `runs/`, which the rule above would swallow anyway)
hardware/flights/*
!hardware/flights/.gitkeep
# ... except the privileged teacher's DAgger demos with memory (14 files, ~4 MB each): every memory
# run's imitation term needs them (HANDOVER.md)
!hardware/flights/demos/
hardware/flights/demos/*
!hardware/flights/demos/dagger_n1_r*.npz
hardware/config.local.yaml
hardware/calibration/camera_intrinsics.json
hardware/calibration/markers/
.pytest_cache/
