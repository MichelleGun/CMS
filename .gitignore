# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/

# training run outputs (keep results/ which is curated; ignore ad-hoc runs)
results_quickstart/
runs/
tb/
# ... except the dashboard's training runs: keep what a teammate needs to use or continue a run
# (models + summaries), not the bulky live files (telemetry, camera frames, logs, replays)
!results/hoop/runs/
results/hoop/runs/*/*
!results/hoop/runs/*/best_model.zip
!results/hoop/runs/*/latest_model.zip
!results/hoop/runs/*/final_model.zip
!results/hoop/runs/*/meta.json
!results/hoop/runs/*/label.json
!results/hoop/runs/*/live_status.json
!results/hoop/runs/*/evaluations.npz
!results/hoop/runs/*/passes.json
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# hardware: flight logs / demos / per-setup calibration are regenerated on each machine
# (`flights/` is deliberately not called `runs/`, which the rule above would swallow anyway)
hardware/flights/*
!hardware/flights/.gitkeep
hardware/config.local.yaml
hardware/calibration/camera_intrinsics.json
hardware/calibration/markers/
.pytest_cache/
