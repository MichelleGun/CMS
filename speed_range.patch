diff --git a/hardware/onboard/speed_stress.py b/hardware/onboard/speed_stress.py
new file mode 100644
index 0000000..fee52f1
--- /dev/null
+++ b/hardware/onboard/speed_stress.py
@@ -0,0 +1,113 @@
+"""
+How much does a policy rely on the simulator's forward/sideways speed being right?
+
+The real Tello's forward and sideways speed was never measured in the cage (sim_fidelity.md:
+the velocity telemetry is too noisy there; over the mission pads forward came out ~2x the sim).
+The corner entries that clipped the hoop on the real drone are flown partly blind, on the ring
+tracker's dead reckoning at the nominal speed, so a speed error lands right on the rim.
+
+This scores oblique entry (slanted starts near the ring, as from a corner of the cage; the same
+starts as export_policy.oblique_entry) with the forward and sideways stick gain multiplied by
+each factor. A policy that holds up at 0.6x and 2x is safer to fly than one that only works at 1x.
+
+    python hardware/onboard/speed_stress.py results/hoop/runs/w10_n9_O_oblique/latest_model.zip
+    python hardware/onboard/speed_stress.py A.zip B.zip --mults 0.6 1 1.5 2 --episodes 60
+
+A run folder can be given instead of a zip (its latest_model.zip). Episodes per cell default to
+60 (oblique entry is a share, so 30 starts is +-18 points; 60 is about +-13).
+"""
+import argparse
+import sys
+from concurrent.futures import ProcessPoolExecutor
+from dataclasses import replace
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+CMS = HERE.parents[1]
+for p in (HERE, HERE.parent, CMS / "scripts"):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+
+SEED = 970_000_000           # layouts no other scoring tool uses
+
+
+def _resolve(arg: str) -> Path:
+    p = Path(arg)
+    if p.is_dir():
+        p = p / "latest_model.zip"
+    if not p.is_file():
+        sys.exit(f"no policy at {p}")
+    from rescore_checkpoints import _meta_for
+    run = p.parent.parent if p.parent.name == "checkpoints" else p.parent
+    _meta_for(p, run)            # checkpoints need their run's meta.json beside them
+    return p
+
+
+def _cell(job):
+    model, mult, episodes, seed = job
+    from onboard import spec
+    from onboard.gym_env import OnboardHoopEnv
+    from onboard.policy import load_policy
+    from onboard.sim import PROFILES
+    from export_policy import env_kwargs
+    fn = load_policy(Path(model))
+    tracker = fn.obs_width == spec.TRACKER_OBS_DIM
+    kw = dict(env_kwargs(fn.meta, tracker), laps=1)
+    base = PROFILES[kw["profile"]] if isinstance(kw["profile"], str) else kw["profile"]
+    kw["profile"] = replace(base, name=f"speed x{mult:g}",
+                            gain_fb=base.gain_fb * mult, gain_lr=base.gain_lr * mult)
+    env = OnboardHoopEnv(seed=seed, oblique_p=1.0, **kw)
+    env.set_episode_seed(seed)
+    ok = struck = 0
+    try:
+        for _ in range(episodes):
+            obs, _ = env.reset()
+            if hasattr(fn, "reset"):
+                fn.reset()
+            done, info = False, {}
+            while not done:
+                obs, _, term, trunc, info = env.step(fn(obs))
+                done = term or trunc
+            ok += info.get("phase") == "passed"
+            struck += info.get("phase") == "struck"
+    finally:
+        env.close()
+    return model, mult, ok / episodes, struck / episodes
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("models", nargs="+")
+    ap.add_argument("--mults", type=float, nargs="+", default=[0.6, 1.0, 1.5, 2.0])
+    ap.add_argument("--episodes", type=int, default=60)
+    ap.add_argument("--workers", type=int, default=4, help="processes (~0.5 GB each)")
+    ap.add_argument("--seed", type=int, default=SEED)
+    a = ap.parse_args(argv)
+    models = [str(_resolve(m)) for m in a.models]
+    jobs = [(m, k, a.episodes, a.seed) for m in models for k in a.mults]
+    print(f"scoring {len(models)} policies x {len(a.mults)} speeds x {a.episodes} slanted starts "
+          f"on {min(a.workers, len(jobs))} workers ...", flush=True)
+    res = {}
+    with ProcessPoolExecutor(max_workers=max(1, min(a.workers, len(jobs)))) as ex:
+        for model, mult, ok, struck in ex.map(_cell, jobs):
+            res[(model, mult)] = (ok, struck)
+            print(f"  {Path(model).parent.name}/{Path(model).name} at x{mult:g}: "
+                  f"{ok:.0%} pass, {struck:.0%} strike", flush=True)
+
+    def name(m):
+        p = Path(m)
+        run = p.parent.parent.name if p.parent.name == "checkpoints" else p.parent.name
+        return f"{run}/{p.stem}"
+
+    print("\nOblique entry (clean pass from a slanted start) with the forward/sideways speed off by:\n")
+    print("| Policy | " + " | ".join(f"x{k:g}" for k in a.mults) + " | worst |")
+    print("|---|" + "---|" * (len(a.mults) + 1))
+    for m in models:
+        vals = [res[(m, k)][0] for k in a.mults]
+        print(f"| {name(m)} | " + " | ".join(f"{v:.0%}" for v in vals) + f" | {min(vals):.0%} |")
+    print(f"\n{a.episodes} starts per cell: differences under ~{1.96 * 0.5 / a.episodes ** 0.5:.0%} are noise. "
+          "The same starts are used for every policy and speed.")
+
+
+if __name__ == "__main__":
+    main()
